{
  "index_patterns": ["documents"],
  "template": {
    "settings": {
      "number_of_shards": 1,
      "number_of_replicas": 0,
      "analysis": {
        "filter": {
          "cs_stop": {
            "type": "stop",
            "stopwords": "_czech_"
          },
          "cs_hunspell": {
            "type": "hunspell",
            "locale": "cs_CZ",
            "dedup": true
          }
        },
        "analyzer": {
          "cs_text": {
            "type": "custom",
            "tokenizer": "standard",
            "filter": ["lowercase", "cs_stop", "cs_hunspell"]
          },
          "cs_folded": {
            "type": "custom",
            "tokenizer": "standard",
            "filter": ["lowercase", "asciifolding"]
          }
        }
      }
    },
    "mappings": {
      "properties": {
        "content": {
          "type": "text",
          "analyzer": "cs_text",
          "fields": {
            "folded": {
              "type": "text",
              "analyzer": "cs_folded"
            },
            "raw": {
              "type": "text",
              "analyzer": "standard"
            }
          }
        },
        "filename": {
          "type": "text",
          "fields": {
            "keyword": {
              "type": "keyword",
              "ignore_above": 512
            }
          }
        },
        "s3_bucket": { "type": "keyword" },
        "s3_key": { "type": "keyword" },
        "sha256": { "type": "keyword" },
        "content_type": { "type": "keyword" },
        "size_bytes": { "type": "long" },
        "indexed_at": { "type": "date" },
        "extracted_at": { "type": "date" },
        "tika_version": { "type": "keyword" }
      }
    }
  }
}
