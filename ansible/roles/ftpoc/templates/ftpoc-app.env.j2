# Managed by Ansible (ansible/roles/ftpoc/templates/ftpoc-app.env.j2).
# Referenced via EnvironmentFile= by the ingest-api/worker/scanner/search-api
# quadlets - mirrors x-ftpoc-env in fulltext-poc/docker-compose.yml.
FTPOC_S3_ENDPOINT=http://rustfs:9000
FTPOC_S3_PUBLIC_ENDPOINT=http://{{ ftpoc_public_host }}:9000
FTPOC_S3_ACCESS_KEY={{ ftpoc_rustfs_access_key }}
FTPOC_S3_SECRET_KEY={{ ftpoc_rustfs_secret_key }}
FTPOC_S3_BUCKET=documents
FTPOC_OPENSEARCH_URL=http://opensearch:9200
FTPOC_OPENSEARCH_USER=admin
FTPOC_OPENSEARCH_PASSWORD={{ ftpoc_opensearch_admin_password }}
FTPOC_POSTGRES_DSN=postgresql://{{ ftpoc_postgres_user | urlencode }}:{{ ftpoc_postgres_password | urlencode }}@postgres:5432/{{ ftpoc_postgres_db }}
FTPOC_REDIS_URL=redis://redis:6379/0
FTPOC_TIKA_URL=http://tika:9998
FTPOC_SCANNER_INTERVAL_SECONDS={{ ftpoc_scanner_interval_seconds }}
