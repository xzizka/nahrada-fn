# Managed by Ansible (ansible/roles/ftpoc/templates/ftpoc-secrets.env.j2).
# Referenced via EnvironmentFile= (not inline Environment=) by the
# rustfs/postgres quadlets, so these values never appear in
# `systemctl cat` / `ps aux` / the systemd journal.
RUSTFS_ACCESS_KEY={{ ftpoc_rustfs_access_key }}
RUSTFS_SECRET_KEY={{ ftpoc_rustfs_secret_key }}
POSTGRES_USER={{ ftpoc_postgres_user }}
POSTGRES_PASSWORD={{ ftpoc_postgres_password }}
POSTGRES_DB={{ ftpoc_postgres_db }}
