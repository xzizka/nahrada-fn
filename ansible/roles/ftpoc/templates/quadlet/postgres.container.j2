[Unit]
Description=ftpoc postgres (authoritative metadata)

[Container]
ContainerName=postgres
# Locally built, not pulled: bundles the Czech hunspell dictionary into
# tsearch_data so 002-fts.sql's ispell dictionary can find it (see
# postgres/Dockerfile, and the "Build the postgres image" task).
Image=localhost/ftpoc-postgres:local
Network=ftpoc.network
Volume=postgres-data.volume:/var/lib/postgresql
Volume={{ ftpoc_deploy_dir }}/postgres/001-schema.sql:/docker-entrypoint-initdb.d/001-schema.sql:ro
Volume={{ ftpoc_deploy_dir }}/postgres/002-fts.sql:/docker-entrypoint-initdb.d/002-fts.sql:ro
PublishPort={{ ftpoc_bind_addr }}:5432:5432
EnvironmentFile={{ ftpoc_deploy_dir }}/ftpoc-secrets.env
HealthCmd=pg_isready -U {{ ftpoc_postgres_user }} -d {{ ftpoc_postgres_db }}
HealthInterval=5s
HealthTimeout=5s
HealthRetries=20
Notify=healthy

[Service]
Restart=always
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
