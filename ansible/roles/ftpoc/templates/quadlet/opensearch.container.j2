[Unit]
Description=ftpoc opensearch

[Container]
ContainerName=opensearch
Image=docker.io/opensearchproject/opensearch:3.8.0
Network=ftpoc.network
Volume=opensearch-data.volume:/usr/share/opensearch/data
Volume={{ ftpoc_deploy_dir }}/opensearch/hunspell:/usr/share/opensearch/config/hunspell:ro
PublishPort={{ ftpoc_bind_addr }}:9200:9200
EnvironmentFile={{ ftpoc_deploy_dir }}/ftpoc-secrets.env
Environment=discovery.type=single-node
# bootstrap.memory_lock left at its default (false): this host's LXC container
# caps RLIMIT_MEMLOCK at 8MB (confirmed via `ulimit -l`, not raisable from
# inside the guest), nowhere near enough to lock a 2g heap - crun rejects any
# attempt to raise it at all with "setrlimit: Operation not permitted", which
# previously crash-looped this container. The heap may be swappable on hosts
# with this constraint; raise the container's memlock ceiling at the LXC/host
# level first if that tradeoff isn't acceptable.
Environment="OPENSEARCH_JAVA_OPTS=-Xms2g -Xmx2g"
# Security plugin stays ON (basic auth intact, via OPENSEARCH_INITIAL_ADMIN_PASSWORD
# in ftpoc-secrets.env); only HTTP-layer TLS is disabled - see fulltext-poc/README.md.
Environment=plugins.security.ssl.http.enabled=false
# References $OPENSEARCH_INITIAL_ADMIN_PASSWORD from EnvironmentFile rather than
# embedding the password again here, so it doesn't show up a second time in
# `systemctl cat`/journal output.
HealthCmd=/bin/sh -c "curl -s -u admin:$OPENSEARCH_INITIAL_ADMIN_PASSWORD http://localhost:9200/_cluster/health | grep -Eq '\"status\":\"(green|yellow)\"'"
HealthInterval=10s
HealthTimeout=5s
HealthRetries=30
HealthStartPeriod=30s
Notify=healthy

[Service]
Restart=always
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
