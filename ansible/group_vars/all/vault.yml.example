---
# Copy this file to vault.yml, fill in real values, then encrypt it:
#   cp group_vars/all/vault.yml.example group_vars/all/vault.yml
#   ansible-vault encrypt group_vars/all/vault.yml
# group_vars/all/vault.yml is gitignored - it must never be committed in plaintext.

vault_rustfs_access_key: "CHANGE-ME-access-key"
vault_rustfs_secret_key: "CHANGE-ME-secret-key-min-8-chars"

vault_postgres_user: "ftpoc"
vault_postgres_password: "CHANGE-ME-postgres-password"
vault_postgres_db: "ftpoc"
